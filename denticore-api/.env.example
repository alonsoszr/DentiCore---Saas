APP_NAME=DentiCore
APP_ENV=local
# Clave maestra (SDD §1.7.1): cifra las claves de cada clínica. `php artisan key:generate`.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Orígenes de la SPA permitidos por CORS (lista separada por comas).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origen de la SPA para los enlaces de los correos (activación, restablecimiento).
SPA_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16 del docker-compose.yml de la raíz (puerto del equipo 5433).
# La API se conecta como denticore_app; las migraciones usan el rol propietario:
#   php artisan migrate --database=pgsql_migrator
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=denticore
DB_USERNAME=denticore_app
DB_PASSWORD=app_local
DB_MIGRATOR_USERNAME=denticore_migrator
DB_MIGRATOR_PASSWORD=migrator_local
DB_PLATFORM_USERNAME=denticore_platform
DB_PLATFORM_PASSWORD=platform_local

SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Redis 7 del docker-compose.yml (puerto del equipo 6380).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

# Mailpit del docker-compose.yml: bandeja en http://localhost:8025.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@denticore.test"
MAIL_FROM_NAME="${APP_NAME}"

# Almacenamiento S3 (MinIO en local, consola en http://localhost:9001).
AWS_ACCESS_KEY_ID=denticore
AWS_SECRET_ACCESS_KEY=denticore_local
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=denticore
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Sellado de evidencias (SDD §1.7, DD-46). Generar con: php -r "echo base64_encode(random_bytes(32));"
EVIDENCE_HMAC_KEY=

# Motor ML (SDD §1.5 IE-02). Provisional: solo /v1/health.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_KEY=

# Antivirus de stored_files (supuesto S-08: ClamAV).
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
